# GEMINI_API_KEY: Required for Gemini AI API calls (unused unless explicitly enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Set one server-only credential source. Never place the service account in client code.
# FIREBASE_SERVICE_ACCOUNT_PATH: Local path to the downloaded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=""
# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON string for Firebase Admin SDK when running outside GCP ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_STORAGE_BUCKET=""

# Owner identity is server-only. Keep this empty in templates and set it in the local/production secret store.
OWNER_ADMIN_EMAIL=""

# PAYMOB PAYMENT GATEWAY (Disabled until configured)
PAYMOB_ENABLED="false"
PAYMOB_MODE="test"
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""

# TRANSACTIONAL EMAIL PROVIDER (Disabled until configured)
EMAIL_ENABLED="false"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""
